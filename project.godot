; Arquivo de configuração do projeto Godot 4.

config_version=5

[application]

config/name="Arena Pixel"
config/version="0.1"
config/description="Combate 1x1 local em plataformas, pixel art, feito para rodar no navegador."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

Jogo="*res://scripts/jogo.gd"
Rede="*res://scripts/rede.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/scale_mode="fractional"

[layer_names]

2d_physics/layer_1="paredes"
2d_physics/layer_2="jogadores"
2d_physics/layer_3="minions"
2d_physics/layer_5="plataformas"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.07, 0.07, 0.12, 1)
